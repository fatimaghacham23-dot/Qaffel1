# Copy to .env.local and fill in values. Never commit .env.local.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used in receipt links, emails, absolute URLs). Use https in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: AI proof review (GitHub Models) ---
# PAT with `models` scope — server-side only.
GITHUB_MODELS_API_KEY=

# Set to true to enable advisory vision review on pending proofs. Requires GITHUB_MODELS_API_KEY.
AI_VERIFICATION_ENABLED=false

# --- Stripe Billing (server-side only) ---
# Use test keys locally. Never expose these to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Customer Portal configuration ID. Leave blank to use Stripe's default portal config.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Price IDs are configured in Stripe Dashboard. Qaffel does not hardcode amounts.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
